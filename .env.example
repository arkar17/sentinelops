# Copy to .env (gitignored) and fill in locally. Never commit real values.
# There are intentionally no default passwords: compose refuses to start until they are set.

POSTGRES_USER=sentinelops
POSTGRES_DB=sentinelops_dev
# Required. Generate a local-only value, e.g.: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

SENTINELOPS_ENV=development

# Required: AES-256 key ring for organization secrets (monitor URLs, custom headers).
# Generate a local key: python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# then set: SENTINELOPS_SECRET_KEYS={"k1":"<base64 key>"} and SENTINELOPS_SECRET_ACTIVE_KEY_ID=k1
SENTINELOPS_SECRET_KEYS=
SENTINELOPS_SECRET_ACTIVE_KEY_ID=
SENTINELOPS_LOG_LEVEL=INFO

# SYSTEM_ADMIN MFA (TOTP). Required automatically when SENTINELOPS_ENV=production; optional here.
# Separate key ring from the organization secrets above; generate the same way.
# SENTINELOPS_MFA_KEYS={"m1":"<base64 key>"}
# SENTINELOPS_MFA_ACTIVE_KEY_ID=m1
# SENTINELOPS_ADMIN_MFA_REQUIRED=true

# Reverse proxies whose X-Forwarded-For is trusted (CIDR list). Leave empty without a proxy.
# SENTINELOPS_TRUSTED_PROXIES=["10.89.0.0/24"]

# Browser origin of the web app, used in emailed and CLI-printed links.
# SENTINELOPS_PUBLIC_BASE_URL=http://localhost:5173

# Integration tests need a disposable local database named exactly sentinelops_test
# (the harness refuses any other host or name):
# SENTINELOPS_TEST_DATABASE_URL=postgresql+asyncpg://postgres:<password>@127.0.0.1:<port>/sentinelops_test

# Only needed when running the API on the host instead of in Docker:
# SENTINELOPS_DATABASE_URL=postgresql+asyncpg://sentinelops:<password>@127.0.0.1:5432/sentinelops_dev
